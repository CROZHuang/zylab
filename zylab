#!/usr/bin/env python3
"""zylab 启动器：解压即用的入口（`./zylab`）。程序本体在旁边的 zylab.py —— 它保留 .py 后缀
是为了测试能 `import zylab`；这里只做 runpy，永远不会与本体产生偏斜。"""
import os
import runpy
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
runpy.run_path(os.path.join(HERE, "zylab.py"), run_name="__main__")
